# ============================================================
# .env.example — Environment variable reference
# Real-Time Anomaly Detection System
# Copy to .env and fill in all values before running.
# NEVER commit .env to version control.
# ============================================================

# ────────────────────────────────────────────
# APPLICATION
# ────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# Anomaly score threshold (0.0–1.0). Events above this are flagged.
ANOMALY_SCORE_THRESHOLD=0.7

# ────────────────────────────────────────────
# JWT AUTHENTICATION (FastAPI)
# ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=changeme-generate-a-secure-random-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ────────────────────────────────────────────
# TIMESCALEDB (PostgreSQL 16 + TimescaleDB 2.15)
# ────────────────────────────────────────────
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=anomaly_db
TIMESCALE_USER=anomaly_admin
TIMESCALE_PASSWORD=changeme-strong-password-here

# Write-only worker user (ML inference consumer)
TIMESCALE_WORKER_USER=anomaly_worker
TIMESCALE_WORKER_PASSWORD=changeme-worker-password-here

# Read-only Grafana user
TIMESCALE_GRAFANA_USER=grafana_reader
TIMESCALE_GRAFANA_PASSWORD=changeme-grafana-reader-password

# Full DATABASE_URL for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://anomaly_admin:changeme-strong-password-here@timescaledb:5432/anomaly_db

# ────────────────────────────────────────────
# KAFKA (Apache Kafka 3.7 / Confluent 7.6)
# ────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Topics (must match architecture.docx Section 4)
KAFKA_RAW_EVENTS_TOPIC=raw-events
KAFKA_SCORED_EVENTS_TOPIC=scored-events
KAFKA_ALERTS_TOPIC=alerts
KAFKA_MODEL_UPDATES_TOPIC=model-updates

# Consumer group IDs
KAFKA_CONSUMER_GROUP_ID=ml-inference-group
KAFKA_WRITER_GROUP_ID=timescaledb-writer-group
KAFKA_ALERT_GROUP_ID=alert-agent-group
KAFKA_DASHBOARD_GROUP_ID=dashboard-bridge-group

# Consumer configuration
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_MAX_POLL_INTERVAL_MS=300000
KAFKA_SESSION_TIMEOUT_MS=30000

# Topic partitions (from architecture.docx Section 4)
KAFKA_RAW_EVENTS_PARTITIONS=6
KAFKA_SCORED_EVENTS_PARTITIONS=6
KAFKA_ALERTS_PARTITIONS=3
KAFKA_MODEL_UPDATES_PARTITIONS=1

# ────────────────────────────────────────────
# REDIS (v7.2 — Rate Limiting + Cache)
# ────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme-redis-password
REDIS_URL=redis://:changeme-redis-password@redis:6379/0
REDIS_TTL_SECONDS=300
REDIS_MAX_CONNECTIONS=50

# ────────────────────────────────────────────
# MINIO (S3-Compatible Artifact Storage)
# ────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=changeme-minio-access-key
MINIO_SECRET_KEY=changeme-minio-secret-key-min-8-chars
MINIO_BUCKET_MODELS=ml-models
MINIO_BUCKET_DATASETS=training-datasets
MINIO_USE_SSL=false

# ────────────────────────────────────────────
# MLFLOW (Experiment Tracking v2.13)
# ────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=anomaly-detection
MODEL_ARTIFACT_PATH=/app/artifacts

# ────────────────────────────────────────────
# GRAFANA (v10.4)
# ────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-grafana-admin-password
GRAFANA_HOST=grafana
GRAFANA_PORT=3000
GRAFANA_URL=http://grafana:3000

# ────────────────────────────────────────────
# PROMETHEUS (v2.52)
# ────────────────────────────────────────────
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_URL=http://prometheus:9090

# ────────────────────────────────────────────
# KAFKA-UI (v0.7)
# ────────────────────────────────────────────
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=changeme-kafka-ui-password

# ────────────────────────────────────────────
# LLM / ANTHROPIC (Claude claude-sonnet-4-20250514 — Agent Reasoning)
# ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-changeme-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.0

# ────────────────────────────────────────────
# LANGGRAPH / LANGCHAIN (Agent Framework)
# ────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=changeme-langsmith-api-key
LANGCHAIN_PROJECT=anomaly-detection

# ────────────────────────────────────────────
# NOTIFICATION AGENTS
# ────────────────────────────────────────────
# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/changeme/changeme/changeme
SLACK_CHANNEL=#anomaly-alerts

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=changeme-smtp-password
SMTP_FROM=alerts@example.com
ALERT_EMAIL_RECIPIENTS=oncall@example.com,sre@example.com

# PagerDuty
PAGERDUTY_INTEGRATION_KEY=changeme-pagerduty-integration-key

# ────────────────────────────────────────────
# APSCHEDULER (Task Scheduling v3.10)
# ────────────────────────────────────────────
RETRAINING_CRON_HOUR=2
RETRAINING_CRON_MINUTE=0
HEALTH_CHECK_INTERVAL_SECONDS=60
REPORT_GENERATION_CRON=0 8 * * *

# ────────────────────────────────────────────
# CORS & API GATEWAY
# ────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
API_V1_PREFIX=/api/v1
WEBSOCKET_PATH=/ws/events
