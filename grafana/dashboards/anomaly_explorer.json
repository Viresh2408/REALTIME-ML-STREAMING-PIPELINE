{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "drawStyle": "points",
            "pointSize": 6,
            "lineWidth": 0,
            "lineInterpolation": "linear"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.7 }
            ]
          },
          "min": 0,
          "max": 1
        }
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
          "rawSql": "SELECT event_time AS time, anomaly_score AS \"Score\", source_id FROM anomaly.anomaly_events WHERE $__timeFilter(event_time) ORDER BY event_time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "title": "Anomaly Score Scatter Plot (Score vs Time)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        }
      },
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 10 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
          "rawSql": "SELECT source_id AS \"Source ID\", COUNT(*) AS \"Total Anomalies\", ROUND(AVG(anomaly_score)::numeric, 4) AS \"Average Anomaly Score\" FROM anomaly.anomaly_events WHERE is_anomaly = true AND $__timeFilter(event_time) GROUP BY source_id ORDER BY \"Total Anomalies\" DESC LIMIT 10",
          "format": "table",
          "refId": "A"
        }
      ],
      "title": "Top 10 Anomalous source_ids",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Source ID" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Drilldown to Overview",
                    "url": "/d/overview-dashboard?var-source_id=${__data.fields['Source ID']}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 14, "x": 10, "y": 10 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
          "rawSql": "SELECT event_id AS \"Event ID\", event_time AS \"Time\", source_id AS \"Source ID\", anomaly_score AS \"Score\", processed_at AS \"Processed At\" FROM anomaly.anomaly_events WHERE is_anomaly = true AND $__timeFilter(event_time) ORDER BY event_time DESC LIMIT 100",
          "format": "table",
          "refId": "A"
        }
      ],
      "title": "Recent Anomalies (Drilldown enabled)",
      "type": "table"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["anomaly-detection", "explorer", "timescaledb"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "Anomaly Explorer",
  "uid": "anomaly-explorer",
  "version": 1
}
