{
  "__inputs": [
    {
      "name": "DS_TIMESCALEDB",
      "label": "TimescaleDB",
      "description": "",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    },
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__elements": {},
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Anomaly Annotations",
        "rawQuery": true,
        "rawSql": "SELECT extract(epoch from event_time)*1000 AS time, 'Anomaly' AS title, concat('Score: ', round(anomaly_score::numeric, 3), ' | Source: ', source_id) AS text, 'anomaly' AS tags FROM anomaly.anomaly_events WHERE is_anomaly = true AND $__timeFilter(event_time) ORDER BY event_time",
        "type": "tags"
      }
    ]
  },
  "description": "Real-Time Anomaly Detection — Live anomaly rate, score distribution, and alert feed",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          },
          "unit": "percent",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
          "rawSql": "SELECT NOW() AS time, ROUND(100.0 * SUM(CASE WHEN is_anomaly THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0), 2) AS anomaly_rate_pct FROM anomaly.anomaly_events WHERE $__timeFilter(event_time)",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "title": "Anomaly Rate %",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
          "rawSql": "SELECT NOW() AS time, COUNT(*) AS anomaly_count FROM anomaly.anomaly_events WHERE is_anomaly = true AND $__timeFilter(event_time)",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "title": "Total Anomalies",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "blue", "mode": "fixed" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
          "rawSql": "SELECT NOW() AS time, COUNT(*) AS total FROM anomaly.anomaly_events WHERE $__timeFilter(event_time)",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "title": "Total Events Processed",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 4,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
          "rawSql": "SELECT time_bucket('$__interval', event_time) AS time, AVG(anomaly_score) AS avg_score, MAX(anomaly_score) AS max_score FROM anomaly.anomaly_events WHERE $__timeFilter(event_time) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "title": "Anomaly Score Distribution (Avg & Max)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 1, "fillOpacity": 5 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 5,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
          "rawSql": "SELECT time_bucket('$__interval', event_time) AS time, source_id, COUNT(*) FILTER (WHERE is_anomaly) AS anomaly_count FROM anomaly.anomaly_events WHERE $__timeFilter(event_time) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "title": "Anomaly Count per Source",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "displayMode": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "anomaly_score" }, "properties": [{ "id": "custom.displayMode", "value": "color-background" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] } }] },
          { "matcher": { "id": "byName", "options": "is_anomaly" }, "properties": [{ "id": "custom.displayMode", "value": "color-background" }, { "id": "mappings", "value": [{ "type": "value", "options": { "true": { "text": "🚨 YES", "color": "red" }, "false": { "text": "✅ NO", "color": "green" } } }] }] }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "id": 6,
      "options": { "sortBy": [{ "displayName": "event_time", "desc": true }] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
          "rawSql": "SELECT event_time, event_id, source_id, anomaly_score, is_anomaly, model_version FROM anomaly.anomaly_events WHERE $__timeFilter(event_time) ORDER BY event_time DESC LIMIT 100",
          "format": "table",
          "refId": "A"
        }
      ],
      "title": "Recent Events — Live Alert Feed",
      "type": "table"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["anomaly-detection", "kafka", "timescaledb", "ml"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "source_id",
        "options": [],
        "query": {
          "query": "SELECT DISTINCT source_id FROM anomaly.anomaly_events ORDER BY 1",
          "refId": "StandardVariableQuery"
        },
        "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
        "refresh": 2,
        "type": "query",
        "label": "Source ID"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Anomaly Detection Overview",
  "uid": "anomaly-overview",
  "version": 1,
  "weekStart": ""
}
